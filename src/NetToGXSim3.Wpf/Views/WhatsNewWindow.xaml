<Window x:Class="NetToGXSim3.Wpf.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="What's New - NetToGXSim3"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        Height="580" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC" Foreground="#0F172A">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBlue" Color="#0284C7"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Header Banner -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E0F2FE" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="✨" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Release Notes &amp; Changelog" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#E0F2FE" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderVersion" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Explore new features, protocol enhancements, and architectural upgrades in NetToGXSim3." FontSize="12" Foreground="#64748B" Margin="38,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🌐 View on GitHub" Style="{StaticResource ModernButton}" Background="#0F172A" Padding="12,6" FontSize="11" VerticalAlignment="Center" Click="BtnViewGithub_Click"/>
            </Grid>
        </Border>

        <!-- Bottom Action Bar -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock Text="NetToGXSim3 • Developed by Ismail Lowkey" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <Button Content="Close" Width="90" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- Scrollable Release Notes Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- Version 0.6.3 Card -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="0,0,0,14" BorderBrush="#BAE6FD" BorderThickness="1.5">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0284C7" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="v0.6.3" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Rolling Log Buffer &amp; High-Performance Traffic Management" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <Border Background="#ECFDF5" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="CURRENT" FontWeight="Bold" FontSize="10.5" Foreground="#059669"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡ 500-Line Rolling Traffic Buffer" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Realtime network activity and MC packet stream log is now capped at 500 lines. The oldest records are automatically pruned as new packets arrive, preventing memory accumulation and eliminating UI slowdowns." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🚀 High-Speed UI Thread Efficiency" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Optimized sub-millisecond string truncation guarantees silky-smooth, flicker-free UI rendering even under dense 50+ requests/sec continuous polling from HMI and SCADA clients." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Version 0.6.2 Card -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#64748B" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="v0.6.2" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Automated Centralized Versioning &amp; Architecture Modernization" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📦 Single Source of Truth Versioning" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Centralized build versioning across all assemblies via Directory.Build.props. Application UI badges, window titles, and update checker now resolve versions dynamically from assembly metadata." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚙️ Automated Dynamic Installer Pipeline" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Upgraded NSIS build script to extract assembly versioning directly from compiled binaries, ensuring synchronized installer package outputs." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Version 0.6.1 Card -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#64748B" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="v0.6.1" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Authoritative Memory Mapping &amp; Data Register Persistence" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🎯 Exact D &amp; M Register Memory Mapping" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Extracted authoritative device offsets directly from FSimRun3/FX5U.dll runtime tables: D0–D7999 at 0x061A50 (16 KB) and M0–M4095 at 0x066408 (512 B). Resolved issue where writing odd values to D0 was cleared by simulator internal alignment flags." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🔒 Persistent Device Value Synchronization" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Values written to Data Registers (D) and Internal Relays (M) from external MC protocol clients (HMI, SCADA, Python) now remain persistent and immediately reflect in GX Works 3 Watch windows without reverting." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Version 0.6.0 Card -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#64748B" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="v0.6.0" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Pure On-Demand MC Protocol &amp; Bidirectional Force Synchronization" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡ Pure On-Demand MC Protocol Server" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="All MC TCP and UDP read/write requests (e.g. M0, D0, X, Y) now bypass background cache mirrors and execute directly against live simulator shared memory on demand with instantaneous sub-microsecond response." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🔄 Bidirectional GX Works 3 Force Table Synchronization" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Resolved simulator latch lock where inputs forced ON inside GX Works 3 (Shift+Enter) could not be turned OFF from external tools. The engine now synchronizes Base RAM, Simulation Force Latch, and ASIC images." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🚀 Direct GXS-IO Memory Bridge Optimization" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Optimized direct block word and bit access paths without COM apartment dispatch, enabling ultra-high-speed polling and zero CPU overhead." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Version 0.5.3 Card -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#64748B" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="v0.5.3" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Single-Instance Protection &amp; Quick App Navigation" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🔒 Single-Instance Application Guard" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Integrated named Mutex protection ensures only one instance of NetToGXSim3 runs concurrently. If a second instance is launched, an informative error dialog is displayed to prevent COM port collisions and simulator driver conflicts." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🚀 'My Apps' Ecosystem Menu Integration" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Added a dedicated 'My Apps' menu in the top navigation bar for one-click access to open-source companion tools: Mitsubishi Net To GXsim2, Net To GXsim3, Omron Net To Cx Sim, and MPS Pneumatic Simulator." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡ Runtime Stability &amp; Resource Cleanup" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Enhanced graceful lifecycle shutdown routines for background socket listeners and STA COM apartment workers." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Version 0.5.1 Card -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#64748B" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="v0.5.1" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Direct GX Simulator 3 Connection &amp; Official Repository Integration" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🚀 Direct Simulator Driver Engine (No MX Component Station Needed)" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Connects directly to the active GX Simulator 3 runtime (FSimRun3 / Sim3Dlg) without needing MX Component station setup or ActComm. Truly zero-configuration plug &amp; play out of the box." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡ Multi-Mode Auto-Probe Architecture" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Intelligently auto-detects FX5U/FX5UJ/FX5S or iQ-R/Q/L simulation targets with instant failover and sub-millisecond memory read/write cycles." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🛡️ Robust Diagnostic Logging &amp; Auto-Recovery" FontWeight="Bold" FontSize="12" Foreground="#0284C7" Margin="0,0,0,3"/>
                                <TextBlock Text="Live connection diagnostics in the packet logger, automatic reconnection on simulator restart, and seamless STA COM dispatching." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Version 0.4.0 Card -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#64748B" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="v0.4.0" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                </Border>
                                <TextBlock Text="MC Protocol UDP Support &amp; Background Auto-Update" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡ Dedicated MC TCP &amp; UDP Binary Servers" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="Independent Server 1 (TCP) and Server 2 (UDP) listen simultaneously on dedicated ports. HMIs, SCADA packages, and IoT clients connecting via UDP or TCP receive immediate, synchronized responses." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🔄 Automated GitHub Update Checker" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="Silently queries the GitHub Releases API upon startup. Real-time version status with an interactive update modal prompt." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="✍️ MC Protocol Random Write Support (0x1402)" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="Full implementation for Command 0x1402 (scattered bit and word/dword write), guaranteeing smooth operation with HMI pushbuttons, numeric inputs, and alarms." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Version 0.3.0 Card -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#64748B" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="v0.3.0" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Memory Mirror Engine &amp; Modern Industrial Dashboard" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🚀 High-Speed PlcMemoryMirror Architecture" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="Optimized STA COM background cache mirror for instant sub-millisecond responses without thread deadlocks or COM contention." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🎛️ Digital I/O Rack &amp; Traffic Inspector" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="Interactive X0-X7 input toggle switches, glowing Y0-Y7 output LED indicators, on-demand device inspector, and live packet stream logger." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🛑 GX Simulator 3 Process Cleaner" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBlock Text="One-click termination for background simulator processes (FSim3Dlg, FSimRun3, Sim3Dlg, IOSystem) directly from the UI." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
