<Window x:Class="NetToGXSim3.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NetToGXSim3 - Mitsubishi GX Works 3 Simulator Network Bridge by Ismail Lowkey" 
        Icon="pack://application:,,,/Resources/app_icon.ico"
        Height="790" Width="1080" 
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9" Foreground="#0F172A">

    <Window.Resources>
        <!-- Modern Clean Palette -->
        <SolidColorBrush x:Key="CardGradient" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0" />
        <SolidColorBrush x:Key="AccentBlue" Color="#0284C7" />
        <SolidColorBrush x:Key="AccentGreen" Color="#16A34A" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleInputStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="#F1F5F9" CornerRadius="8,8,0,0" Padding="14,8" Margin="0,0,4,0" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,4" FontSize="12">
            <MenuItem Header="_File">
                <MenuItem Header="🛑  Exit GX Simulator 3" Click="BtnExitGxSim_Click" />
                <Separator/>
                <MenuItem Header="❌  Exit" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle Inspector &amp; Log Tab" Click="MenuToggleLog_Click" />
                <MenuItem Header="What's New" Click="MenuWhatsNew_Click" />
            </MenuItem>
            <MenuItem Header="🚀 _My Apps" FontWeight="SemiBold">
                <MenuItem Header="⚡ Mitsubishi Net To GXsim2" Click="MenuApp_NetToGXSim2_Click" FontWeight="Normal" />
                <MenuItem Header="⚡ Mitsubishi Net To GXsim3" Click="MenuApp_NetToGXSim3_Click" FontWeight="Normal" />
                <MenuItem Header="🔌 Omron Net To Cx Sim" Click="MenuApp_OmronNetToCXSim_Click" FontWeight="Normal" />
                <MenuItem Header="💨 MPS Pneumatic Simulator" Click="MenuApp_MPSPneumaticSimulator_Click" FontWeight="Normal" />
            </MenuItem>
            <MenuItem Header="🔄 Check for Updates" Click="MenuCheckUpdate_Click" FontWeight="SemiBold" Foreground="#0284C7"/>
            <MenuItem Header="✨ What's New" Click="MenuWhatsNew_Click" FontWeight="SemiBold" Foreground="#2563EB"/>
            <MenuItem Header="_Help">
                <MenuItem Header="📖 User Guide" Click="MenuGuide_Click" />
                <MenuItem Header="✨ What's New" Click="MenuWhatsNew_Click" />
                <MenuItem Header="🔄 Check for Updates..." Click="MenuCheckUpdate_Click" />
                <Separator/>
                <MenuItem Header="ℹ About NetToGXSim3" Click="MenuAbout_Click" />
            </MenuItem>
        </Menu>

        <!-- Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Application Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFooterVersion" Text="NetToGXSim3" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text=" • Mitsubishi GX Works 3 Network Bridge" FontSize="11" Foreground="#94A3B8" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Right: Auto Update Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="MenuCheckUpdate_Click" ToolTip="Click to check for updates">
                    <Ellipse x:Name="UpdateStatusLed" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtUpdateStatus" Text="Checking for updates..." FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Margin="16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Status Panel -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="16,10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Width="42" Height="42" Margin="0,0,12,0" ClipToBounds="True" Background="#0F172A">
                            <Image Source="pack://application:,,,/Resources/app_icon.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="NetToGXSim3" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,10,0"/>
                                <Border Background="#E0F2FE" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtHeaderVersion" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="by Ismail Lowkey" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                                </Border>
                                <Border Background="#ECFDF5" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="FX5 / iQ-R" FontSize="11" FontWeight="Bold" Foreground="#059669" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Mitsubishi GX Works 3 Simulator Network Bridge (MC Protocol A-1E / QnA-3E)" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Badges & Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- GX Sim Status -->
                        <Border CornerRadius="20" Padding="14,6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SimStatusLed" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" />
                                <TextBlock x:Name="TxtSimStatus" Text="GX Sim 3: Offline" FontSize="12" FontWeight="Bold" Foreground="#475569" ToolTip="Waiting for GX Works 3 simulation to start (Debug -> Start Simulation)" />
                            </StackPanel>
                        </Border>

                        <!-- Check for Updates Button -->
                        <Button Content="🔄 Check for Updates" Margin="10,0,0,0" Height="30" Padding="12,4"
                                Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11"
                                ToolTip="Check for newer versions on GitHub"
                                Style="{StaticResource ModernButton}" Click="MenuCheckUpdate_Click"/>

                        <!-- Exit GX Simulator 3 Button -->
                        <Button x:Name="BtnExitGxSim" Content="Exit GX Simulator 3" Margin="10,0,0,0" Height="30" Padding="12,4"
                                Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="11"
                                ToolTip="Force close / terminate simulator processes (FSim3Dlg, FSimRun3, Sim3Dlg, IOSystem)"
                                Style="{StaticResource ModernButton}" Click="BtnExitGxSim_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SERVER INSTANCES CONTROL CARD & ARCHITECTURE OVERVIEW -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="16,10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Left side: MC Servers configuration -->
                                <ColumnDefinition Width="Auto" MinWidth="360"/>
                                <!-- Divider -->
                                <ColumnDefinition Width="28"/>
                                <!-- Right side: Architecture flow diagram -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Servers Control -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MC PROTOCOL SERVERS" FontSize="11" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,10"/>

                                <!-- Server 1 (Top): MC TCP Binary Server - Default Port 5000 (Started by default) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="Server1Led" Width="10" Height="10" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MC TCP Binary Server:" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Grid.Column="1" Margin="0,0,10,0"/>
                                    <TextBlock Text="Port:" FontSize="11.5" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" Grid.Column="2"/>
                                    <TextBox x:Name="TxtPortServer1" Text="5000" FontSize="12" FontWeight="SemiBold" Padding="4,3" VerticalAlignment="Center" Grid.Column="3" TextAlignment="Center" BorderBrush="#CBD5E1" IsEnabled="False"/>
                                    <Button x:Name="BtnToggleServer1" Content="Stop" Width="64" Height="26" Margin="10,0,0,0" Grid.Column="4" Style="{StaticResource ModernButton}" Click="BtnToggleServer1_Click"/>
                                </Grid>

                                <Separator Background="#F1F5F9" Margin="0,2,0,8"/>

                                <!-- Server 2 (Bottom): MC UDP Binary Server - Default Port 6000 (Stopped by default) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="Server2Led" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MC UDP Binary Server:" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Grid.Column="1" Margin="0,0,10,0"/>
                                    <TextBlock Text="Port:" FontSize="11.5" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" Grid.Column="2"/>
                                    <TextBox x:Name="TxtPortServer2" Text="6000" FontSize="12" FontWeight="SemiBold" Padding="4,3" VerticalAlignment="Center" Grid.Column="3" TextAlignment="Center" BorderBrush="#CBD5E1" IsEnabled="True"/>
                                    <Button x:Name="BtnToggleServer2" Content="Start" Width="64" Height="26" Margin="10,0,0,0" Grid.Column="4" Style="{StaticResource ModernButton}" Click="BtnToggleServer2_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Vertical Divider -->
                            <Rectangle Grid.Column="1" Width="1" Fill="#E2E8F0" Margin="12,2,12,2" HorizontalAlignment="Center"/>

                            <!-- Right: Architecture Overview Flow Diagram (Native Boxes & Text) -->
                            <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Left: GX Works 3 & GX Simulator 3 -->
                                    <StackPanel VerticalAlignment="Center" Width="115">
                                        <Border Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="6" Padding="6,5" Margin="0,0,0,6">
                                            <TextBlock Text="GX Works 3" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="6" Padding="6,5">
                                            <TextBlock Text="GX Simulator 3" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Arrow to Bridge -->
                                    <StackPanel VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="⇄" FontSize="18" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                        <TextBlock Text="COM" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Center: NetToGXSim3 -->
                                    <Border Background="#0284C7" BorderBrush="#0369A1" BorderThickness="1.5" CornerRadius="8" Padding="12,10" VerticalAlignment="Center" MinWidth="105">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="NetToGXSim3" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="App Bridge" FontSize="10" FontWeight="SemiBold" Foreground="#BAE6FD" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Arrow to Clients -->
                                    <StackPanel VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="⇄" FontSize="18" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                        <TextBlock Text="TCP / UDP" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Right: SCADA, OPC, Node-RED, HMI -->
                                    <UniformGrid Columns="2" Rows="2" VerticalAlignment="Center" Width="165">
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="6,5" Margin="2">
                                            <TextBlock Text="SCADA" FontWeight="Bold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="6,5" Margin="2">
                                            <TextBlock Text="OPC" FontWeight="Bold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="6,5" Margin="2">
                                            <TextBlock Text="Node-RED" FontWeight="Bold" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="6,5" Margin="2">
                                            <TextBlock Text="HMI" FontWeight="Bold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Main Tabs -->
                    <TabControl Grid.Row="2" x:Name="MainTabControl" Background="Transparent" BorderThickness="0">
                        <!-- TAB 1: I/O RACK (Inputs X0-X7 & Outputs Y0-Y7) -->
                        <TabItem Header="I/O Rack (X0 - X7 &amp; Y0 - Y7)" Style="{StaticResource ModernTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,8,0,0">
                                    <!-- INPUT RACK CARD (X0 to X7) -->
                                    <Border Background="#FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="9" Height="9" CornerRadius="4.5" Background="#2563EB" Margin="0,0,7,0" />
                                                    <TextBlock Text="INPUT DIGITAL RACK (X0 - X17 / Octal)" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" />
                                                </StackPanel>
                                                <TextBlock Text="Toggle switches to simulate digital input states (X0 - X17) in GX Simulator 3" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Grid for 16 Inputs (X0 to X7, X10 to X17) -->
                                            <UniformGrid x:Name="InputGrid" Columns="8" Rows="2" MinHeight="112"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- OUTPUT RACK CARD (Y0 to Y17) -->
                                    <Border Background="#FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="9" Height="9" CornerRadius="4.5" Background="#16A34A" Margin="0,0,7,0" />
                                                    <TextBlock Text="OUTPUT DIGITAL RACK (Y0 - Y17 / Octal)" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" />
                                                </StackPanel>
                                                <TextBlock Text="Output LED indicators reflect virtual PLC coil logic in GX Simulator 3 in real-time" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Grid for 16 Outputs (Y0 to Y7, Y10 to Y17) -->
                                            <UniformGrid x:Name="OutputGrid" Columns="8" Rows="2" MinHeight="112"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: INSPECTOR & ACTIVITY LOG -->
                        <TabItem x:Name="TabAdvancedInspector" Style="{StaticResource ModernTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#7C3AED" Margin="0,0,7,0"/>
                                    <TextBlock Text="Inspector &amp; Traffic Log" FontWeight="Bold"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="380"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Custom Address Inspector Card -->
                                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ANY DEVICE INSPECTOR" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                        <TextBlock Text="Read &amp; Write Any Variable (X, Y, M, D, C, T, S)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,4"/>
                                        <TextBlock Text="Supported device examples: X0, Y0, M0, D0, T0, C0" FontSize="11" Foreground="#64748B" Margin="0,0,0,16"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                             <TextBox x:Name="TxtCustomAddress" Text="D0" FontSize="14" FontWeight="Bold" Background="#F8FAFC" Foreground="#0369A1" BorderBrush="#CBD5E1" Padding="8,6" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="READ" Style="{StaticResource ModernButton}" Click="BtnReadCustom_Click" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="TOGGLE" Style="{StaticResource ModernButton}" Background="#059669" Click="BtnToggleCustom_Click"/>
                                        </Grid>

                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
                                            <TextBlock x:Name="TxtCustomResult" Text="Bit: [OFF] | Value: 0" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Value:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                                            <TextBox x:Name="TxtWriteWordValue" Grid.Column="1" Text="0" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="WRITE" Style="{StaticResource ModernButton}" Click="BtnWriteCustomWord_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Realtime Activity Log Card -->
                                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <TextBlock Text="REALTIME NETWORK TRAFFIC &amp; ACTIVITY LOG" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                                            <Button Content="Clear Log" Style="{StaticResource ModernButton}" Background="#64748B" Padding="10,4" FontSize="11" HorizontalAlignment="Right" Click="BtnClearLog_Click"/>
                                        </Grid>

                                        <TextBox x:Name="TxtLog" Grid.Row="1" Background="#F8FAFC" Foreground="#1E293B" BorderBrush="#E2E8F0" BorderThickness="1" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Padding="10" IsReadOnly="True" VerticalScrollBarVisibility="Visible"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
        </Grid>
    </DockPanel>
</Window>
