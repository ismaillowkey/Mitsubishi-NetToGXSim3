<Window x:Class="NetToGXSim3.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NetToGXSim3 - Mitsubishi GX Works 3 Simulator Network Bridge by Ismail Lowkey" 
        Icon="pack://application:,,,/Resources/app_icon.ico"
        Height="790" Width="1220" 
        MinHeight="650" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9" Foreground="#0F172A">

    <Window.Resources>
        <!-- Modern Clean Palette -->
        <SolidColorBrush x:Key="CardGradient" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0" />
        <SolidColorBrush x:Key="AccentBlue" Color="#0284C7" />
        <SolidColorBrush x:Key="AccentGreen" Color="#16A34A" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleInputStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style TabItem Utama dengan Border yang Menyatu ke Kotak Tab -->
        <!-- Style TabItem Utama dengan Border yang Menyatu ke Kotak Tab -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" 
                                Background="#E2E8F0" 
                                CornerRadius="8,8,0,0" 
                                Padding="16,8" 
                                Margin="0,0,4,0" 
                                BorderBrush="#94A3B8" 
                                BorderThickness="1.5,1.5,1.5,1.5">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="tabBorder" Property="BorderThickness" Value="1.5,3,1.5,0"/>
                                <Setter TargetName="tabBorder" Property="Margin" Value="0,0,4,-1"/>
                                <Setter TargetName="tabBorder" Property="Padding" Value="16,9,16,9"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Panel.ZIndex" Value="20"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style TabControl Utama dengan Kotak Pembatas Konten Jelas -->
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header Barisan Tab -->
                            <TabPanel Grid.Row="0" IsItemsHost="True" Panel.ZIndex="10" Margin="4,0,4,-1"/>
                            
                            <!-- Kotak Tab (Pembatas Konten Tab dengan Border Solid) -->
                            <Border Grid.Row="1" 
                                    Background="#FFFFFF" 
                                    BorderBrush="#94A3B8" 
                                    BorderThickness="1.5" 
                                    CornerRadius="0,8,8,8" 
                                    Padding="14"
                                    Panel.ZIndex="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" 
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Sub-Tab Item (Modbus Sub-Tabs) -->
        <Style x:Key="ModernSubTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="subTabBorder" 
                                Background="#E2E8F0" 
                                CornerRadius="6,6,0,0" 
                                Padding="14,6" 
                                Margin="0,0,3,0" 
                                BorderBrush="#94A3B8" 
                                BorderThickness="1,1,1,1">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="subTabBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="subTabBorder" Property="BorderBrush" Value="#D97706"/>
                                <Setter TargetName="subTabBorder" Property="BorderThickness" Value="1.5,2.5,1.5,0"/>
                                <Setter TargetName="subTabBorder" Property="Margin" Value="0,0,3,-1"/>
                                <Setter TargetName="subTabBorder" Property="Padding" Value="14,7,14,7"/>
                                <Setter Property="Foreground" Value="#D97706"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Panel.ZIndex" Value="20"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="subTabBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Sub-TabControl (Kotak Sub-Tab Modbus) -->
        <Style x:Key="ModernSubTabControl" TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header Barisan Sub-Tab -->
                            <TabPanel Grid.Row="0" IsItemsHost="True" Panel.ZIndex="10" Margin="4,0,4,-1"/>
                            
                            <!-- Kotak Pembatas Konten Sub-Tab -->
                            <Border Grid.Row="1" 
                                    Background="#F8FAFC" 
                                    BorderBrush="#CBD5E1" 
                                    BorderThickness="1.5" 
                                    CornerRadius="0,8,8,8" 
                                    Padding="10"
                                    Panel.ZIndex="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" 
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,4" FontSize="12">
            <MenuItem Header="_File">
                <MenuItem Header="🛑  Exit GX Simulator 3" Click="BtnExitGxSim_Click" />
                <Separator/>
                <MenuItem Header="❌  Exit" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle Inspector &amp; Log Tab" Click="MenuToggleLog_Click" />
                <MenuItem Header="What's New" Click="MenuWhatsNew_Click" />
            </MenuItem>
            <MenuItem Header="🚀 _My Apps" FontWeight="SemiBold">
                <MenuItem Header="⚡ Mitsubishi Net To GXsim2" Click="MenuApp_NetToGXSim2_Click" FontWeight="Normal" />
                <MenuItem Header="⚡ Mitsubishi Net To GXsim3" Click="MenuApp_NetToGXSim3_Click" FontWeight="Normal" />
                <MenuItem Header="🔌 Omron Net To Cx Sim" Click="MenuApp_OmronNetToCXSim_Click" FontWeight="Normal" />
                <MenuItem Header="💨 MPS Pneumatic Simulator" Click="MenuApp_MPSPneumaticSimulator_Click" FontWeight="Normal" />
            </MenuItem>
            <MenuItem Header="🔄 Check for Updates" Click="MenuCheckUpdate_Click" FontWeight="SemiBold" Foreground="#0284C7"/>
            <MenuItem Header="✨ What's New" Click="MenuWhatsNew_Click" FontWeight="SemiBold" Foreground="#2563EB"/>
            <MenuItem Header="_Help">
                <MenuItem Header="📁 Open Example Program HMI" Click="BtnExampleHmi_Click" />
                <Separator/>
                <MenuItem Header="📖 User Guide" Click="MenuGuide_Click" />
                <MenuItem Header="✨ What's New" Click="MenuWhatsNew_Click" />
                <MenuItem Header="🔄 Check for Updates..." Click="MenuCheckUpdate_Click" />
                <Separator/>
                <MenuItem Header="ℹ About NetToGXSim3" Click="MenuAbout_Click" />
            </MenuItem>
        </Menu>

        <!-- Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Application Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFooterVersion" Text="NetToGXSim3" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text=" • Mitsubishi GX Works 3 Network Bridge" FontSize="11" Foreground="#94A3B8" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Right: Auto Update Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="MenuCheckUpdate_Click" ToolTip="Click to check for updates">
                    <Ellipse x:Name="UpdateStatusLed" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtUpdateStatus" Text="Checking for updates..." FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Margin="16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Status Panel -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="16,10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Width="42" Height="42" Margin="0,0,12,0" ClipToBounds="True" Background="#0F172A">
                            <Image Source="pack://application:,,,/Resources/app_icon.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="NetToGXSim3" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,10,0"/>
                                <Border Background="#E0F2FE" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtHeaderVersion" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="by Ismail Lowkey" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                                </Border>
                                <Border Background="#ECFDF5" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="FX5 / iQ-R" FontSize="11" FontWeight="Bold" Foreground="#059669" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Badges & Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- GX Sim Status -->
                        <Border CornerRadius="20" Padding="14,6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SimStatusLed" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" />
                                <TextBlock x:Name="TxtSimStatus" Text="GX Sim 3: Offline" FontSize="12" FontWeight="Bold" Foreground="#475569" ToolTip="Waiting for GX Works 3 simulation to start (Debug -> Start Simulation)" />
                            </StackPanel>
                        </Border>

                        <!-- Example Program HMI Button -->
                        <Button x:Name="BtnExampleHmi" Content="📁 Example Program HMI" Margin="10,0,0,0" Height="30" Padding="12,4"
                                Background="#0D9488" Foreground="White" FontWeight="Bold" FontSize="11"
                                ToolTip="Open Example Program HMI folder"
                                Style="{StaticResource ModernButton}" Click="BtnExampleHmi_Click"/>

                        <!-- Check for Updates Button -->
                        <Button Content="🔄 Check for Updates" Margin="10,0,0,0" Height="30" Padding="12,4"
                                Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11"
                                ToolTip="Check for newer versions on GitHub"
                                Style="{StaticResource ModernButton}" Click="MenuCheckUpdate_Click"/>

                        <!-- Exit GX Simulator 3 Button -->
                        <Button x:Name="BtnExitGxSim" Content="Exit GX Simulator 3" Margin="10,0,0,0" Height="30" Padding="12,4"
                                Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="11"
                                ToolTip="Force close / terminate simulator processes (FSim3Dlg, FSimRun3, Sim3Dlg, IOSystem)"
                                Style="{StaticResource ModernButton}" Click="BtnExitGxSim_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SERVER INSTANCES CONTROL CARD & ARCHITECTURE OVERVIEW -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="16,10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Left side: MC Servers configuration -->
                                <ColumnDefinition Width="Auto" MinWidth="360"/>
                                <!-- Divider -->
                                <ColumnDefinition Width="28"/>
                                <!-- Right side: Architecture flow diagram -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Servers Control -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MC PROTOCOL SERVERS" FontSize="11" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,10"/>

                                <!-- Server 1 (Top): MC TCP Binary Server - Default Port 5001 (Started by default) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="Server1Led" Width="10" Height="10" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MC TCP Binary Server:" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Grid.Column="1" Margin="0,0,10,0"/>
                                    <Border Background="#F1F5F9" CornerRadius="5" Padding="10,4" VerticalAlignment="Center" Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="FX5U" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"/>
                                    </Border>
                                    <TextBlock Text="Port:" FontSize="11.5" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" Grid.Column="3"/>
                                    <TextBox x:Name="TxtPortServer1" Text="5001" FontSize="12" FontWeight="SemiBold" Padding="4,3" VerticalAlignment="Center" Grid.Column="4" TextAlignment="Center" BorderBrush="#CBD5E1" IsEnabled="False"/>
                                    <Button x:Name="BtnToggleServer1" Content="Stop" Width="64" Height="26" Margin="10,0,0,0" Grid.Column="5" Style="{StaticResource ModernButton}" Click="BtnToggleServer1_Click"/>
                                </Grid>

                                <Separator Background="#F1F5F9" Margin="0,2,0,8"/>

                                <!-- Server 2 (Bottom): MC UDP Binary Server - Default Port 5002 (Stopped by default) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="Server2Led" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MC UDP Binary Server:" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Grid.Column="1" Margin="0,0,10,0"/>
                                    <Border Background="#F1F5F9" CornerRadius="5" Padding="10,4" VerticalAlignment="Center" Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="FX5U" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"/>
                                    </Border>
                                    <TextBlock Text="Port:" FontSize="11.5" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" Grid.Column="3"/>
                                    <TextBox x:Name="TxtPortServer2" Text="5002" FontSize="12" FontWeight="SemiBold" Padding="4,3" VerticalAlignment="Center" Grid.Column="4" TextAlignment="Center" BorderBrush="#CBD5E1" IsEnabled="True"/>
                                    <Button x:Name="BtnToggleServer2" Content="Start" Width="64" Height="26" Margin="10,0,0,0" Grid.Column="5" Style="{StaticResource ModernButton}" Click="BtnToggleServer2_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Vertical Divider -->
                            <Rectangle Grid.Column="1" Width="1" Fill="#E2E8F0" Margin="12,2,12,2" HorizontalAlignment="Center"/>

                            <!-- Right: Architecture Overview Flow Diagram (Native Boxes & Text) -->
                            <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Left: GX Works 3 & GX Simulator 3 -->
                                    <StackPanel VerticalAlignment="Center" Width="115">
                                        <Border Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="6" Padding="6,5" Margin="0,0,0,6">
                                            <TextBlock Text="GX Works 3" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="6" Padding="6,5">
                                            <TextBlock Text="GX Simulator 3" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Arrow to Bridge -->
                                    <StackPanel VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="⇄" FontSize="18" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                        <TextBlock Text="COM" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Center: NetToGXSim3 -->
                                    <Border Background="#0284C7" BorderBrush="#0369A1" BorderThickness="1.5" CornerRadius="8" Padding="12,10" VerticalAlignment="Center" MinWidth="105">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="NetToGXSim3" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="App Bridge" FontSize="10" FontWeight="SemiBold" Foreground="#BAE6FD" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Arrow to Clients -->
                                    <StackPanel VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="⇄" FontSize="18" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                        <TextBlock Text="TCP / UDP" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Right: SCADA, OPC, Node-RED, HMI -->
                                    <UniformGrid Columns="2" Rows="2" VerticalAlignment="Center" Width="165">
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="6,5" Margin="2">
                                            <TextBlock Text="SCADA" FontWeight="Bold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="6,5" Margin="2">
                                            <TextBlock Text="OPC" FontWeight="Bold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="6,5" Margin="2">
                                            <TextBlock Text="Node-RED" FontWeight="Bold" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="6,5" Margin="2">
                                            <TextBlock Text="HMI" FontWeight="Bold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Main Tabs -->
                    <TabControl Grid.Row="2" x:Name="MainTabControl" Style="{StaticResource ModernTabControl}" Margin="0,4,0,0">
                        <!-- TAB 1: I/O RACK (Inputs X0-X7 & Outputs Y0-Y7) -->
                        <TabItem Header="I/O Rack (X0 - X7 &amp; Y0 - Y7)" Style="{StaticResource ModernTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- INPUT RACK CARD (X0 to X7) -->
                                    <Border Background="#F8FAFC" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="9" Height="9" CornerRadius="4.5" Background="#2563EB" Margin="0,0,7,0" />
                                                    <TextBlock Text="INPUT DIGITAL RACK (X0 - X17 / Octal)" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" />
                                                </StackPanel>
                                                <TextBlock Text="Toggle switches to simulate digital input states (X0 - X17) in GX Simulator 3" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Grid for 16 Inputs (X0 to X7, X10 to X17) -->
                                            <UniformGrid x:Name="InputGrid" Columns="8" Rows="2" MinHeight="112"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- OUTPUT RACK CARD (Y0 to Y17) -->
                                    <Border Background="#F8FAFC" CornerRadius="10" Padding="14,10" Margin="0,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="9" Height="9" CornerRadius="4.5" Background="#16A34A" Margin="0,0,7,0" />
                                                    <TextBlock Text="OUTPUT DIGITAL RACK (Y0 - Y17 / Octal)" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" />
                                                </StackPanel>
                                                <TextBlock Text="Output LED indicators reflect virtual PLC coil logic in GX Simulator 3 in real-time" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Grid for 16 Outputs (Y0 to Y7, Y10 to Y17) -->
                                            <UniformGrid x:Name="OutputGrid" Columns="8" Rows="2" MinHeight="112"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: OPC DA SERVER (CLASSIC COM) -->
                        <TabItem x:Name="TabOpcDaServer" Style="{StaticResource ModernTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#0284C7" Margin="0,0,7,0"/>
                                    <TextBlock Text="OPC DA Server" FontWeight="Bold"/>
                                    <TextBlock Text="(Classic COM)" FontSize="11" Foreground="#64748B" Margin="6,0,0,0"/>
                                </StackPanel>
                            </TabItem.Header>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0">
                                <StackPanel Margin="0,0,10,0">
                                    <!-- OPC Server State Control Card -->
                                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Server State Info -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                    <Ellipse x:Name="OpcStatusLed" Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="TxtOpcServerStatus" Text="OPC DA SERVER: RUNNING (AUTO-STARTED)" FontSize="13" FontWeight="Bold" Foreground="#047857"/>
                                                    <Border Background="#F3E8FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                        <TextBlock Text="Auto-Save ON" FontSize="10" FontWeight="Bold" Foreground="#7C3AED"/>
                                                    </Border>
                                                </StackPanel>
                                                <WrapPanel Margin="0,2,0,0">
                                                    <TextBlock Text="ProgID: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                                    <TextBlock Text="NetToGXSim3.OPCServer.DA" FontSize="11" Foreground="#0284C7" FontWeight="Bold" Margin="0,0,14,0"/>

                                                    <TextBlock Text="CLSID: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{}{4A7E0D2C-3F5B-4C91-95E8-8F2B1A6D7C90}" FontSize="11" Foreground="#64748B" FontFamily="Consolas" Margin="0,0,14,0"/>

                                                    <TextBlock Text="Active Clients: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtOpcClientsCount" Text="0" FontSize="11" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,14,0"/>

                                                    <TextBlock Text="Total Tags: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtOpcTotalTags" Text="0" FontSize="11" Foreground="#0F172A" FontWeight="Bold"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Server Actions -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnStartOpcServer" Content="▶ Start Server" Style="{StaticResource ModernButton}" Background="#10B981" Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnStartOpcServer_Click"/>
                                                <Button x:Name="BtnStopOpcServer" Content="⏹ Stop Server" Style="{StaticResource ModernButton}" Background="#EF4444" Padding="12,6" Margin="0,0,8,0" Visibility="Visible" Click="BtnStopOpcServer_Click"/>
                                                <Button x:Name="BtnRegisterOpcServer" Content="Register in Windows" Style="{StaticResource ModernButton}" Background="#64748B" Padding="12,6" Click="BtnRegisterOpcServer_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- OPC DA Client Lifecycle Notice -->
                                    <Border Background="#FEF2F2" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderBrush="#FCA5A5" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#991B1B" LineHeight="16" TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Run FontWeight="Bold" Text="OPC Client Lifecycle Notice:"/>
                                                <Run Text=" If an external OPC DA client (e.g., OPC Expert, Matrikon, Kepware, InTouch, WinCC) is actively connected/polling and NetToGXSim3 is closed, Windows COM will automatically relaunch NetToGXSim3. To exit completely, disconnect or close the OPC DA client first."/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- TAG MANAGEMENT WORKSTATION (KEPWARE STYLE) -->
                                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="320"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Workstation Title & Auto-Save Badge -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="#8B5CF6" Margin="0,0,8,0"/>
                                                    <TextBlock Text="OPC DA TAG WORKSTATION &amp; ADDRESS MAPPING" FontSize="12" FontWeight="Bold" Foreground="#6D28D9"/>
                                                    <TextBlock Text="— Auto-saved on add/edit/delete, live linked with GX Simulator 3" FontSize="11" Foreground="#64748B" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,3" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtTagStoragePath" Text="Storage: opc_tags.json" FontSize="10.5" Foreground="#64748B"/>
                                                </Border>
                                            </Grid>

                                            <!-- Action Toolbar -->
                                            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="+ Add Tag" Style="{StaticResource ModernButton}" Background="#0284C7" Padding="12,5" Margin="0,0,8,0" Click="BtnAddOpcTag_Click"/>
                                                        <Button Content="⚡ Reset Presets" Style="{StaticResource ModernButton}" Background="#64748B" Padding="12,5" Click="BtnResetOpcPresets_Click"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Export CSV" Style="{StaticResource ModernButton}" Background="#475569" Padding="10,5" Margin="0,0,6,0" Click="BtnExportOpcCsv_Click"/>
                                                        <Button Content="Import CSV" Style="{StaticResource ModernButton}" Background="#475569" Padding="10,5" Click="BtnImportOpcCsv_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- DataGrid of Tags -->
                                            <DataGrid x:Name="DgOpcTags" Grid.Row="2"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      SelectionMode="Single"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      HorizontalGridLinesBrush="#E2E8F0"
                                                      Background="#FFFFFF"
                                                      AlternatingRowBackground="#F8FAFC"
                                                      RowHeight="30"
                                                      FontSize="12"
                                                      BorderBrush="#E2E8F0"
                                                      BorderThickness="1"
                                                      SelectionChanged="DgOpcTags_SelectionChanged"
                                                      MouseDoubleClick="DgOpcTags_MouseDoubleClick">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="55"/>

                                                    <DataGridTextColumn Header="Tag Name" Binding="{Binding TagName}" Width="160">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Margin" Value="6,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Header="PLC Address" Binding="{Binding Address}" Width="110">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                                <Setter Property="Foreground" Value="#0284C7"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Margin" Value="6,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" Width="85">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="11"/>
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Margin" Value="6,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Header="Live Value" Binding="{Binding Value}" Width="130">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                                <Setter Property="Foreground" Value="#047857"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Margin" Value="6,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <DataGridTemplateColumn Header="Quality / Status" Width="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#EF4444"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Quality}" Value="Good">
                                                                                        <Setter Property="Background" Value="#10B981"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Quality}" Value="Offline">
                                                                                        <Setter Property="Background" Value="#94A3B8"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Quality}" FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Quality}" Value="Good">
                                                                                        <Setter Property="Foreground" Value="#047857"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Quality}" Value="Offline">
                                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTextColumn Header="Last Updated" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" Width="110">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                                <Setter Property="FontSize" Value="11"/>
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Margin" Value="6,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Header="Description / Comment" Binding="{Binding Description}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Margin" Value="6,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Rightmost Actions Column: Edit & Delete -->
                                                    <DataGridTemplateColumn Header="Actions" Width="135">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Button Content="Edit"
                                                                            Style="{StaticResource ModernButton}"
                                                                            Background="#475569"
                                                                            Padding="8,2"
                                                                            FontSize="11"
                                                                            Margin="0,0,5,0"
                                                                            Click="BtnRowEditTag_Click"
                                                                            Tag="{Binding}"
                                                                            ToolTip="Edit this tag"/>
                                                                    <Button Content="Delete"
                                                                            Style="{StaticResource ModernButton}"
                                                                            Background="#DC2626"
                                                                            Padding="8,2"
                                                                            FontSize="11"
                                                                            Click="BtnRowDeleteTag_Click"
                                                                            Tag="{Binding}"
                                                                            ToolTip="Delete this tag"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- Test Value Write Panel -->
                                            <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="8" Padding="12,8" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Write Test to Tag:" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtOpcSelectedTag" Text="None (select a row)" FontSize="11" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <TextBox x:Name="TxtOpcWriteValue" Grid.Column="1" Text="1" Padding="6,4" Background="#FFFFFF" BorderBrush="#CBD5E1" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Write to PLC" Style="{StaticResource ModernButton}" Background="#0284C7" Padding="12,4" Margin="0,0,6,0" Click="BtnOpcWrite_Click"/>
                                                        <Button Content="Toggle Bit" Style="{StaticResource ModernButton}" Background="#10B981" Padding="10,4" Click="BtnOpcToggle_Click"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Text="Tips: When GX Simulator 3 is offline, tags will indicate 'Offline' automatically." FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: OPC UA SERVER (MODERN UA) -->
                        <TabItem x:Name="TabOpcUaServer" Style="{StaticResource ModernTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#0D9488" Margin="0,0,7,0"/>
                                    <TextBlock Text="OPC UA Server" FontWeight="Bold"/>
                                    <TextBlock Text="(opc.tcp)" FontSize="11" Foreground="#64748B" Margin="6,0,0,0"/>
                                </StackPanel>
                            </TabItem.Header>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0">
                                <StackPanel Margin="0,0,10,0">
                                    <!-- OPC UA Server State Control Card -->
                                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Server State Info -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                    <Ellipse x:Name="OpcUaStatusLed" Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="TxtOpcUaServerStatus" Text="OPC UA SERVER: RUNNING (AUTO-STARTED)" FontSize="13" FontWeight="Bold" Foreground="#047857"/>
                                                    <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                        <TextBlock Text="Anonymous Allowed" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                                                    </Border>
                                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                                        <TextBlock Text="Auto-Start ON" FontSize="10" FontWeight="Bold" Foreground="#2563EB"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Row 1: Local Endpoint, Port, Sessions, Tags -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,4">
                                                    <TextBlock Text="Local Endpoint: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtOpcUaEndpoint" Text="opc.tcp://localhost:48400/nettogxsim3" FontSize="11" Foreground="#0D9488" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>

                                                    <TextBlock Text="Port: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="26" Margin="0,0,16,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBox x:Name="TxtOpcUaPort" Text="48400" Width="52" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,2,0">
                                                                <Button x:Name="BtnOpcUaPortUp" Content="▲" FontSize="7" Width="16" Height="11" Padding="0" Background="#E2E8F0" BorderThickness="0" Click="BtnOpcUaPortUp_Click" Cursor="Hand"/>
                                                                <Button x:Name="BtnOpcUaPortDown" Content="▼" FontSize="7" Width="16" Height="11" Padding="0" Background="#E2E8F0" BorderThickness="0" Margin="0,1,0,0" Click="BtnOpcUaPortDown_Click" Cursor="Hand"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="Active Sessions: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtOpcUaSessionsCount" Text="0" FontSize="11" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>

                                                    <TextBlock Text="Total Tags: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtOpcUaTotalTags" Text="0" FontSize="11" Foreground="#0F172A" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Row 2: Network Endpoint (Diletakkan tepat di baris bawah Local Endpoint) -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                                                    <TextBlock Text="Network Endpoint: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtOpcUaNetworkEndpoint" Text="opc.tcp://[Host]:48400/nettogxsim3" FontSize="11" Foreground="#0284C7" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Server Actions -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnStartOpcUaServer" Content="▶ Start Server" Style="{StaticResource ModernButton}" Background="#10B981" Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnStartOpcUaServer_Click"/>
                                                <Button x:Name="BtnStopOpcUaServer" Content="⏹ Stop Server" Style="{StaticResource ModernButton}" Background="#EF4444" Padding="12,6" Margin="0,0,8,0" Visibility="Visible" Click="BtnStopOpcUaServer_Click"/>
                                                <Button x:Name="BtnCopyUaEndpoint" Content="📋 Copy Endpoint" Style="{StaticResource ModernButton}" Background="#0D9488" Padding="12,6" Click="BtnCopyUaEndpoint_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Port Collision Notification Banner (Hidden by default, visible if port 48400 occupied) -->
                                    <Border x:Name="BorderOpcUaPortNotice" Background="#FFFBEB" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderBrush="#FCD34D" BorderThickness="1" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtOpcUaPortNotice" Grid.Column="1" FontSize="11" Foreground="#B45309" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="Port 48400 was occupied. Automatically switched to port 48401."/>
                                        </Grid>
                                    </Border>

                                    <!-- Synchronized Tags Table -->
                                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="LIVE SYNCHRONIZED OPC UA TAGS (ADDRESS SPACE: ns=2;s=NetToGXSim3.*)" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </Grid>

                                            <DataGrid x:Name="DgOpcUaTags"
                                                       AutoGenerateColumns="False"
                                                       IsReadOnly="True"
                                                       CanUserAddRows="False"
                                                       CanUserDeleteRows="False"
                                                       SelectionMode="Single"
                                                       HeadersVisibility="Column"
                                                       GridLinesVisibility="Horizontal"
                                                       HorizontalGridLinesBrush="#E2E8F0"
                                                       Background="#FFFFFF"
                                                       AlternatingRowBackground="#F8FAFC"
                                                       RowHeight="30"
                                                       FontSize="12"
                                                       BorderBrush="#E2E8F0"
                                                       BorderThickness="1">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tag Name" Binding="{Binding TagName}" Width="150">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Margin" Value="6,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <DataGridTextColumn Header="OPC UA NodeId" Binding="{Binding TagName, StringFormat='ns=2;s=NetToGXSim3.{0}'}" Width="210">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
